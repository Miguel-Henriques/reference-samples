# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Local dev loads .env via `pnpm dev` (tsx --env-file).
# AWS credentials for AVP are not listed here — use a profile, SSO, or
# standard AWS_* env vars from your credential chain.

# --- Server ---
PORT=8080
LOG_LEVEL=info

# --- Upstream LiteLLM (module-managed internal ALB) ---
LITELLM_BASE_URL=http://litellm.example.com
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# --- OIDC issuer that signs caller JWTs ---
OIDC_ISSUER_URL=https://your-idp.example.com
# OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# OIDC_ROLE_CLAIM=role
# OIDC_TEAM_CLAIM=team_id

# --- Amazon Verified Permissions ---
# After terraform apply: terraform output -raw avp_policy_store_id
AVP_POLICY_STORE_ID=your-avp-policy-store-id
# Must match the top-level key in infra/modules/authorizer/policies/schema.json
# (terraform output -raw avp_namespace).
AVP_NAMESPACE=AI
AWS_REGION=eu-west-1

# --- Virtual key exchange ---
# KEY_CACHE_TTL_SECONDS must stay shorter than VIRTUAL_KEY_DURATION.
VIRTUAL_KEY_DURATION=30d
KEY_CACHE_TTL_SECONDS=28800 # 8 hours
KEY_CLEANUP_GRACE_SECONDS=300 # 5 minutes
# DEFAULT_USER_MAX_BUDGET_USD=25

# --- Optional distributed key cache (in-memory when unset) ---
# REDIS_URL=redis://localhost:6379
