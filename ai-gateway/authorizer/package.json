{
  "name": "@ai-gateway/authorizer",
  "version": "0.1.0",
  "private": true,
  "description": "AuthN/AuthZ proxy in front of LiteLLM: OIDC JWT validation, Amazon Verified Permissions checks, guardrail hooks, and JWT-to-virtual-key exchange.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_ENV=development tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@aws-sdk/client-verifiedpermissions": "^3.1092.0",
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.31",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cedar-policy/cedar-wasm": "^4.11.2",
    "@types/node": "^24.10.9",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
